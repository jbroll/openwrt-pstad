#!/bin/sh
# pstad: gives each allowlisted client behind this repeater its own station on
# the backhaul radio, carrying the client's MAC. Forwarding is tc redirect
# rules per client; this script only manages lifecycle. See docs/architecture.md.

RUN=${RUN:-/var/run/psta}
ALLOW=${ALLOW:-/etc/psta/allow}
CONF=$RUN/wpa.conf
BRIDGE=${PSTA_BRIDGE:-br-lan}
IDLE=${PSTA_IDLE:-300}
SWEEP=${PSTA_SWEEP:-60}
ASSOC=${PSTA_ASSOC:-20}
DOWN_GRACE=${PSTA_DOWN_GRACE:-120}
HOLDOFF=${PSTA_HOLDOFF:-60}
LEAVE_WAIT=${PSTA_LEAVE_WAIT:-3}
RECENT=${PSTA_RECENT:-10}
MONIF=${PSTA_MONIF:-pstamon}
JOIN_DELAY=${PSTA_JOIN_DELAY:-1}
PROC=${PROC:-/proc}
SYS=${SYS:-/sys}
KILL_WAIT=3

log() { logger -t pstad "$*"; }

# "MAC dev PORT [vlan N] master br-lan" -> "MAC PORT". Deleted, permanent and
# self (switch-offloaded) entries are not clients arriving.
fdb_learned() {
	case "$1" in Deleted*|*permanent*|*" self"*) return 1;; esac
	case "$1" in *" master "*) ;; *) return 1;; esac
	set -- $1
	[ "$2" = dev ] || return 1
	printf '%s %s\n' "$1" "$3"
}

# One iw event line -> "arrive IFACE MAC", "leave IFACE MAC" or "kicked IFACE
# SECONDS". iw -t prints "SECONDS.MICROS: IFACE (phy #N): del station MAC"; the
# MAC is the last word. iw-tiny prints a disconnect only as "unknown event 48",
# so a proxy station losing its AP is read from the del station beside it.
iw_event() {
	case "$1" in
	*": new station "*) ev=arrive ;;
	*": del station "*) ev=leave ;;
	*) return 1 ;;
	esac
	set -- $1
	ts=0
	case "$1" in [0-9]*.[0-9]*:) ts=${1%%.*}; shift ;; esac
	iface=${1%:}
	case "$iface" in
	psta-*)
		[ "$ev" = leave ] || return 1
		printf 'kicked %s %s\n' "$iface" "$ts"
		return 0
		;;
	esac
	for mac; do :; done
	printf '%s %s %s\n' "$ev" "$iface" "$mac"
}

# stdin: iw dev X link. Prints "BSSID FREQ", nothing when not connected.
link_params() {
	echo $(sed -n 's/^Connected to \([0-9a-f:]*\).*/\1/p; s/^[[:space:]]*freq: \([0-9]*\).*/\1/p')
}

# stdin: tc -s filter show. The first Sent line is the action's counter.
sent_pkts() {
	sed -n 's/.*Sent [0-9]* bytes \([0-9]*\) pkt.*/\1/p' | head -1
}

iface_for() { printf 'psta-%s\n' "$(printf %s "$1" | tr -d : | tail -c 6)"; }

# Prefs 1-4 are the fixed rules; clients take the lowest free value from 100.
alloc_pref() {
	used=$(cat "$RUN"/*/pref 2>/dev/null)
	p=100
	while printf '%s\n' "$used" | grep -qx "$p"; do p=$(( p + 1 )); done
	echo "$p"
}

# Supplicant auth lines for the backhaul's encryption setting.
key_mgmt() {  # ENCRYPTION
	case "$1" in
	sae)  printf 'key_mgmt=SAE\nieee80211w=2\n' ;;
	psk*) printf 'key_mgmt=WPA-PSK\nieee80211w=1\n' ;;
	*)    printf 'key_mgmt=SAE WPA-PSK\nieee80211w=1\n' ;;
	esac
}

# A lone "*" line proxies every client; otherwise the MAC must be listed.
allowed() { [ -f "$ALLOW" ] || return 1; grep -qxF '*' "$ALLOW" && return 0; grep -qix "$1" "$ALLOW"; }

# A client just torn down for leaving is not re-added from a stale fdb entry
# until HOLDOFF has passed or the AP reports it back.
holdoff() { mkdir -p "$RUN/holdoff"; date +%s > "$RUN/holdoff/$1"; }
held() {
	[ -s "$RUN/holdoff/$1" ] || return 1
	[ $(( $(date +%s) - $(cat "$RUN/holdoff/$1") )) -lt "$HOLDOFF" ] && return 0
	rm -f "$RUN/holdoff/$1"
	return 1
}

# A reassociation deletes the AP's station and adds it back milliseconds later,
# which must not cost the client its upstream station.
returned() {  # PORT MAC
	waited=0
	until iw dev "$1" station get "$2" >/dev/null 2>&1; do
		[ "$waited" -ge "$LEAVE_WAIT" ] && return 1
		sleep 1
		waited=$(( waited + 1 ))
	done
	return 0
}

sta_connected() { iw dev "$1" link 2>/dev/null | grep -q '^Connected to'; }

# "PID IFACE" for every wpa_supplicant on a psta-* station, found by command
# line because an exiting supplicant deletes its pid file even when a newer one
# wrote it. See "Supplicants are found by command line" in docs/architecture.md.
psta_supplicants() {
	for sf in $(grep -l -F wpa_supplicant "$PROC"/[0-9]*/cmdline 2>/dev/null); do
		tr '\0' '\n' 2>/dev/null < "$sf" | {
			read -r argv0 || exit 0
			case "$argv0" in *wpa_supplicant) ;; *) exit 0 ;; esac
			while read -r arg; do
				[ "$arg" = -i ] || continue
				read -r arg
				case "$arg" in psta-*) spid=${sf%/cmdline}; echo "${spid##*/} $arg" ;; esac
			done
		}
	done
}

kill_supplicants() {  # IFACE
	psta_supplicants | while read -r spid siface; do
		[ "$siface" = "$1" ] && kill "$spid" 2>/dev/null
	done
	return 0
}

# kill only signals, so a supplicant can outlive the call by a moment. Waits up
# to KILL_WAIT for none left on IFACE, or on any psta station without one.
await_exit() {  # [IFACE]
	waited=0
	while psta_supplicants | grep -q " ${1:-psta-.*}\$"; do
		[ "$waited" -ge "$KILL_WAIT" ] && return 1
		sleep 1
		waited=$(( waited + 1 ))
	done
	return 0
}

# A supplicant still shutting down would take the interface setup creates next,
# leaving two supplicants on one station.
clear_station() {  # IFACE
	kill_supplicants "$1"
	await_exit "$1" && return 0
	log "supplicant on $1 did not exit in ${KILL_WAIT}s"
	return 1
}

# An unclaimed supplicant holds a client's MAC upstream against its real
# association, and blocks the client's next setup.
reap_orphans() {
	psta_supplicants | while read -r spid siface; do
		mac_of_iface "$siface" >/dev/null && continue
		kill "$spid" 2>/dev/null
		log "killed orphan wpa_supplicant $spid on $siface"
	done
	return 0
}

mac_of_iface() {
	for d in "$RUN"/*/; do
		[ -s "$d/iface" ] && [ "$(cat "$d/iface")" = "$1" ] && { basename "$d"; return 0; }
	done
	return 1
}

# The port-side redirect must not exist before the station can carry frames:
# every frame the client sends would go into an unassociated interface and the
# client would be dark, with the redirect counter still rising so the idle
# sweep never rescues it.
wait_assoc() {  # IFACE
	waited=0
	while [ "$waited" -lt "$ASSOC" ]; do
		sta_connected "$1" && return 0
		sleep 1
		waited=$(( waited + 1 ))
	done
	log "$1 did not associate in ${ASSOC}s"
	return 1
}

backhaul() { ls /sys/class/net | grep -m1 -- '-sta[0-9]*$'; }
phy_of() { cat "/sys/class/net/$1/phy80211/name"; }
backhaul_mac() { cat "/sys/class/net/$(backhaul)/address"; }

# One supplicant config for every client, pinned to the backhaul's BSSID and
# channel: the phy allows one channel across all its interfaces.
write_conf() {
	bh=$(backhaul) || { rm -f "$RUN/bssid"; return 1; }
	set -- $(iw dev "$bh" link | link_params)
	[ -n "$2" ] || { rm -f "$RUN/bssid"; return 1; }
	sec=$(uci show wireless | sed -n "s/^wireless\.\([^.]*\)\.mode='sta'/\1/p" | head -1)
	[ -n "$sec" ] || { rm -f "$RUN/bssid"; return 1; }
	ssid=$(uci get "wireless.$sec.ssid") || { rm -f "$RUN/bssid"; return 1; }
	psk=$(uci get "wireless.$sec.key") || { rm -f "$RUN/bssid"; return 1; }
	auth=$(key_mgmt "$(uci -q get "wireless.$sec.encryption")")
	mkdir -p "$RUN"
	# Subshell umask keeps the PSK out of the conf file's initial permissions,
	# instead of a window between create and chmod. freq_list only filters the
	# BSS choice; without scan_freq each station scans the band and times out.
	( umask 077
	cat > "$CONF" <<-EOF
	network={
		ssid="$ssid"
		bssid=$1
		freq_list=$2
		scan_freq=$2
		$auth
		psk="$psk"
	}
	EOF
	)
	echo "$1" > "$RUN/bssid"
}

forwarder() { cat "$RUN/forwarder" 2>/dev/null; }

# Every station receives the AP's copy of each downstream broadcast, so only
# one carries the group-frame rule. It redirects into the bridge, not a port,
# so every port gets the frame.
add_group_rule() {  # IFACE
	tc filter add dev "$1" ingress pref 4 protocol all \
		flower dst_mac 01:00:00:00:00:00/01:00:00:00:00:00 \
		action mirred egress redirect dev "$BRIDGE"
}

# Keeps the current forwarder while its station is connected; otherwise moves
# the rule to any connected station. A subshell body, because its loop would
# otherwise overwrite the caller's d and iface, and setup uses iface after it.
elect() (
	f=$(forwarder)
	if [ -n "$f" ]; then
		[ -s "$RUN/$f/iface" ] && sta_connected "$(cat "$RUN/$f/iface")" && return 0
		[ -s "$RUN/$f/iface" ] && tc filter del dev "$(cat "$RUN/$f/iface")" ingress pref 4 2>/dev/null
		rm -f "$RUN/forwarder"
	fi
	for d in "$RUN"/*/; do
		[ -s "$d/iface" ] && [ -s "$d/pref" ] || continue
		read -r iface < "$d/iface"
		sta_connected "$iface" || continue
		add_group_rule "$iface" || continue
		basename "$d" > "$RUN/forwarder"
		log "$iface forwards group frames"
		return 0
	done
	return 1
)

setup() {  # MAC PORT
	mac=$1 port=$2 d=$RUN/$1
	[ -s "$RUN/bssid" ] || { log "no backhaul, not adding $mac"; return 1; }
	iface=$(iface_for "$mac") pref=$(alloc_pref)
	mkdir -p "$d"
	echo "$iface" > "$d/iface"; echo "$port" > "$d/port"; echo "$pref" > "$d/pref"
	echo 0 > "$d/count"; date +%s > "$d/seen"; date +%s > "$d/since"
	clear_station "$iface" &&
	# EAPOL must reach hostapd and the supplicant, never the redirect.
	iw phy "$(phy_of "$(backhaul)")" interface add "$iface" type managed addr "$mac" &&
	ip link set "$iface" up &&
	# 9>&- closes the lock fd, or the daemonized supplicant holds it forever.
	wpa_supplicant -B -D nl80211 -i "$iface" -c "$CONF" 9>&- &&
	tc qdisc add dev "$iface" clsact &&
	tc filter add dev "$iface" ingress pref 1 protocol 0x888e flower action pass &&
	tc filter add dev "$iface" ingress pref 2 protocol all flower dst_mac "$mac" \
		action mirred egress redirect dev "$port" &&
	# The AP hands the repeater's own upstream broadcasts back to every
	# station; sent down they read as the repeater claiming a neighbour's
	# address. Sits before the group rule so those copies never reach the LAN.
	tc filter add dev "$iface" ingress pref 3 protocol all flower src_mac "$(backhaul_mac)" \
		action drop &&
	wait_assoc "$iface" &&
	{ elect; true; } &&
	# The AP rebroadcasts the client's own frames to the backhaul, where
	# anything listening behind tc ingress would learn it as an upstream host.
	{ tc qdisc add dev "$(backhaul)" clsact 2>/dev/null; true; } &&
	tc filter add dev "$(backhaul)" ingress pref "$pref" protocol all flower src_mac "$mac" \
		action drop &&
	{ tc qdisc add dev "$port" clsact 2>/dev/null
	  tc filter add dev "$port" ingress pref 1 protocol 0x888e flower action pass 2>/dev/null
	  true; } &&
	tc filter add dev "$port" ingress pref "$pref" protocol all flower src_mac "$mac" \
		action mirred egress redirect dev "$iface" &&
	{ log "up $mac on $port via $iface"; return 0; }
	log "setup failed for $mac on $port"
	teardown "$mac"
	return 1
}

teardown() {  # MAC
	d=$RUN/$1; [ -d "$d" ] || return 0
	# A half-written client dir leaves stale values from a prior call; an
	# empty var here must never be treated as some other client's device.
	unset iface port pref reelect
	[ -s "$d/iface" ] && read -r iface < "$d/iface"
	[ -s "$d/port" ] && read -r port < "$d/port"
	[ -s "$d/pref" ] && read -r pref < "$d/pref"
	[ "$(forwarder)" = "$1" ] && { rm -f "$RUN/forwarder"; reelect=1; }
	[ -n "$port" ] && [ -n "$pref" ] && tc filter del dev "$port" ingress pref "$pref" 2>/dev/null
	[ -n "$pref" ] && tc filter del dev "$(backhaul)" ingress pref "$pref" 2>/dev/null
	[ -n "$iface" ] && kill_supplicants "$iface"
	[ -n "$iface" ] && iw dev "$iface" del 2>/dev/null
	rm -rf "$d"
	log "down $1"
	[ -n "$reelect" ] && { elect; true; }
	return 0
}

teardown_all() {
	rm -f "$RUN/forwarder"
	ports=$(for d in "$RUN"/*/; do [ -f "$d/port" ] && cat "$d/port"; done | sort -u)
	for d in "$RUN"/*/; do
		[ -d "$d" ] && [ "$(basename "$d")" != holdoff ] && teardown "$(basename "$d")"
	done
	rm -rf "$RUN/holdoff"
	# The teardowns above only signalled their supplicants; reaping at once
	# would log each one as an orphan.
	await_exit
	reap_orphans
	for port in $ports; do
		tc filter del dev "$port" ingress pref 1 2>/dev/null
		tc qdisc del dev "$port" clsact 2>/dev/null
	done
	[ -n "$ports" ] && tc qdisc del dev "$(backhaul)" clsact 2>/dev/null
	rm -f "$CONF"
	return 0
}

handle() {  # one bridge fdb line
	line=$(fdb_learned "$1") || return 0
	set -- $line
	allowed "$1" || return 0
	held "$1" && return 0
	if [ -d "$RUN/$1" ]; then
		[ "$(cat "$RUN/$1/port")" = "$2" ] && return 0
		teardown "$1"
	fi
	setup "$1" "$2"
}

# A wired client cannot have roamed; a wireless one is here while its AP heard
# from it within RECENT seconds.
client_here() {  # PORT MAC
	[ -e "$SYS/class/net/$1/phy80211" ] || return 0
	idle=$(iw dev "$1" station get "$2" 2>/dev/null |
		sed -n 's/^[[:space:]]*inactive time:[[:space:]]*\([0-9]*\) ms.*/\1/p')
	[ -n "$idle" ] && [ "$idle" -lt $(( RECENT * 1000 )) ]
}

# A client the AP reports gone has roamed or slept: its station would otherwise
# hold the client's MAC upstream, against the client's real association, until
# the idle window ran out. Deleting the fdb entry stops the sweep re-adding it.
handle_event() {  # one iw event line
	ev=$(iw_event "$1") || return 0
	set -- $ev
	case "$1" in
	arrive)
		rm -f "$RUN/holdoff/$3"
		# A client that has just associated may send nothing for seconds, as
		# traffic for it still goes to its old station, so the bridge would not
		# learn it; the association itself is enough to start its station.
		[ -e "$SYS/class/net/$2/brport" ] && handle "$3 dev $2 master $BRIDGE"
		;;
	leave)
		[ -s "$RUN/$3/port" ] && [ "$(cat "$RUN/$3/port")" = "$2" ] || return 0
		returned "$2" "$3" && return 0
		log "$3 left $2"
		teardown "$3"
		bridge fdb del "$3" dev "$2" master 2>/dev/null
		holdoff "$3"
		;;
	kicked)
		mac=$(mac_of_iface "$2") || return 0
		# A teardown's own del station is read after the lock is released, when
		# setup may already have rebuilt a station under the same name.
		since=$(cat "$RUN/$mac/since" 2>/dev/null)
		[ "$3" -gt "${since:-0}" ] || return 0
		read -r port < "$RUN/$mac/port"
		# The upstream AP drops this station whenever another repeater's
		# station for the same MAC deauthenticates, as a roam between repeaters
		# does; its supplicant associates again within a second.
		if client_here "$port" "$mac"; then
			log "$2 dropped by the AP, client still here"
			return 0
		fi
		log "$2 dropped by the AP, client gone"
		teardown "$mac"
		# No hold-off: a client that comes back is rebuilt by its next frame.
		bridge fdb del "$mac" dev "$port" master 2>/dev/null
		;;
	esac
}

# One monitor line -> "MAC BSSID" for a station joining a BSS on the backhaul
# channel. Frames this radio sent carry no received signal, so the repeater's
# own stations never match. The SSID follows SA: and is sender-controlled, so
# only the first of each field counts.
air_join() {
	case "$1" in *"dBm signal "*) ;; *) return 1 ;; esac
	case "$1" in *" Authentication ("*|*" Assoc Request "*|*" ReAssoc Request "*) ;; *) return 1 ;; esac
	set -f
	b= da= sa=
	for w in $1; do
		case "$w" in
		BSSID:*) [ -n "$b" ] || b=${w#BSSID:} ;;
		DA:*) [ -n "$da" ] || da=${w#DA:} ;;
		SA:*) [ -n "$sa" ] || sa=${w#SA:} ;;
		esac
	done
	[ -n "$sa" ] && [ -n "$b" ] && [ "$da" = "$b" ] || return 1
	printf '%s %s\n' "$sa" "$b"
}

# A client joining the upstream BSS through anything but this repeater, the
# other repeater's proxy station or the router's own radio, has left here even
# if this AP was never told. Two associations for one MAC in one BSS deliver to
# neither, so this station goes, but JOIN_DELAY later: its deauthentication
# makes the router drop the MAC, and landing inside the new association's 4-way
# handshake stalls that for the supplicant's 10 s timeout.
handle_air() {  # one monitor line
	j=$(air_join "$1") || return 0
	set -- $j
	[ "$2" = "$(cat "$RUN/bssid" 2>/dev/null)" ] || return 0
	[ -s "$RUN/$1/port" ] || return 0
	read -r port < "$RUN/$1/port"
	[ -e "$SYS/class/net/$port/phy80211" ] || return 0
	# Authentication and association request both match; one teardown is enough.
	[ -f "$RUN/$1/leaving" ] && return 0
	: > "$RUN/$1/leaving"
	log "$1 joining $2 elsewhere, dropping its station"
	defer "$JOIN_DELAY" left_elsewhere "$1" "$(date +%s)"
}

# Runs a command after SECONDS, under the lock, without holding up the caller.
defer() {  # SECONDS CMD...
	( d=$1; shift; sleep "$d"; locked "$@" ) 9>&- >/dev/null 2>&1 &
}

left_elsewhere() {  # MAC HEARD
	[ -s "$RUN/$1/port" ] || return 0
	since=$(cat "$RUN/$1/since" 2>/dev/null)
	[ "${since:-0}" -le "$2" ] || return 0
	read -r port < "$RUN/$1/port"
	teardown "$1"
	bridge fdb del "$1" dev "$port" master 2>/dev/null
	ubus call "hostapd.$port" del_client "{\"addr\":\"$1\",\"reason\":3,\"deauth\":false,\"ban_time\":0}" >/dev/null 2>&1
	holdoff "$1"
}

dispatch() {
	case "$1" in
	*": new station "*|*": del station "*) handle_event "$1" ;;
	*" BSSID:"*) handle_air "$1" ;;
	*) handle "$1" ;;
	esac
}

# Presence: the bridge stops learning a redirected client, so the redirect's own
# counter is the liveness signal. Ends with a reconciliation pass, because a
# client torn down and back within the bridge's ageing window raises no event.
sweep() {
	set -- $(iw dev "$(backhaul)" link | link_params)
	if [ "$1" != "$(cat "$RUN/bssid" 2>/dev/null)" ]; then
		log "backhaul now on ${1:-nothing}, dropping every station"
		teardown_all
		write_conf
		return
	fi
	now=$(date +%s)
	sups=$(psta_supplicants)
	for d in "$RUN"/*/; do
		[ -s "$d/port" ] && [ -s "$d/pref" ] && [ -s "$d/count" ] && [ -s "$d/seen" ] || continue
		read -r port < "$d/port"; read -r pref < "$d/pref"
		# Two supplicants on one station fight over it; teardown kills both and
		# the fdb pass below rebuilds the client with one.
		if [ -s "$d/iface" ]; then
			read -r iface < "$d/iface"
			n=$(printf '%s\n' "$sups" | grep -c " $iface\$")
			if [ "$n" -gt 1 ]; then
				log "$iface has $n supplicants"
				teardown "$(basename "$d")"
				continue
			fi
		fi
		# A station that dropped off the backhaul still attracts the client's
		# frames through the redirect, so the counter cannot reveal it.
		if [ -s "$d/iface" ]; then
			read -r iface < "$d/iface"
			if sta_connected "$iface"; then
				rm -f "$d/down"
			else
				# A supplicant mid-reassociation reads Not connected for a
				# moment; require DOWN_GRACE of it before rebuilding.
				[ -f "$d/down" ] || echo "$now" > "$d/down"
				read -r down < "$d/down"
				if [ $(( now - down )) -ge "$DOWN_GRACE" ]; then
					log "$iface lost association"
					teardown "$(basename "$d")"
					continue
				fi
			fi
		fi
		n=$(tc -s filter show dev "$port" ingress pref "$pref" | sent_pkts)
		if [ "${n:-0}" -gt "$(cat "$d/count")" ]; then
			echo "$n" > "$d/count"; echo "$now" > "$d/seen"
		elif [ $(( now - $(cat "$d/seen") )) -ge "$IDLE" ]; then
			teardown "$(basename "$d")"
		fi
	done
	reap_orphans
	elect
	bridge fdb show br "$BRIDGE" | while read -r l; do handle "$l"; done
}

# A monitor interface on the backhaul phy hears every station joining the
# upstream BSS on that channel. Rebuilt if a wifi reload removes it.
air_watch() {
	while :; do
		iw dev "$MONIF" del 2>/dev/null
		iw phy "$(phy_of "$(backhaul)")" interface add "$MONIF" type monitor 2>/dev/null &&
			ip link set "$MONIF" up &&
			tcpdump -i "$MONIF" -y IEEE802_11_RADIO -l -e -n -tt \
				'type mgt and (subtype auth or subtype assoc-req or subtype reassoc-req)' 2>/dev/null
		sleep 5
	done
}

# Serializes a concurrent setup/teardown between the monitor and sweep
# instances; handle/sweep never lock themselves so tests can call them direct.
locked() { ( flock 9; "$@" ) 9>"$RUN/lock"; }

[ -n "$PSTAD_LIB" ] && return 0

case "$1" in
monitor)
	mkdir -p "$RUN"
	until write_conf; do sleep 5; done
	rm -f "$RUN/fifo"; mkfifo "$RUN/fifo"
	bridge monitor fdb > "$RUN/fifo" &
	MON=$!
	iw event -t > "$RUN/fifo" &
	IWMON=$!
	if command -v tcpdump >/dev/null; then
		air_watch > "$RUN/fifo" &
		AIR=$!
	else
		log "no tcpdump, clients joining the upstream BSS elsewhere go unseen"
	fi
	trap 'kill $MON $IWMON $AIR; iw dev "$MONIF" del 2>/dev/null; exit' TERM INT
	bridge fdb show br "$BRIDGE" | while read -r l; do locked handle "$l"; done
	while read -r l; do locked dispatch "$l"; done < "$RUN/fifo"
	;;
sweep) mkdir -p "$RUN"; while sleep "$SWEEP"; do locked sweep; done ;;
teardown-all) teardown_all ;;
status)
	f=$(forwarder)
	for d in "$RUN"/*/; do
		[ -s "$d/iface" ] || continue
		m=$(basename "$d")
		echo "$m $(cat "$d/iface") on $(cat "$d/port"), $(cat "$d/count") pkts, seen $(date -d @"$(cat "$d/seen")" 2>/dev/null || cat "$d/seen")$([ "$m" = "$f" ] && echo ', forwards group frames')"
	done
	;;
*) echo "usage: pstad monitor|sweep|teardown-all|status" >&2; exit 1 ;;
esac
